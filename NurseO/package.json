{
  "name": "NurseO",
  "version": "3.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:make_sql": "npx prisma migrate diff --from-empty --to-schema-datasource prisma/schema.prisma --script > prisma/generated.sql",
    "db:diff": "prisma migrate  diff --from-schema-datamodel ./prisma/old.prisma --to-schema-datamodel ./prisma/schema.prisma --script > ./prisma/diff.sql",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "dev": "next dev",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "start": "next start"
  },
